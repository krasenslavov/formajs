{
  "name": "aformajs",
  "version": "1.0.0",
  "description": "Create dynamic and interactive forms with minimal markup and better UX.",
  "type": "module",
  "main": "dist/js/forma.cjs",
  "module": "dist/js/forma.esm.js",
  "types": "index.d.ts",
  "unpkg": "dist/js/forma.min.js",
  "jsdelivr": "dist/js/forma.min.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/js/forma.esm.js",
      "require": "./dist/js/forma.cjs"
    },
    "./css/*": "./dist/css/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.d.ts",
    "src/scss",
    "!src/scss/css"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run clean && npm run build:js && npm run build:css && npm run build:docs",
    "build:js": "node scripts/build-js.mjs",
    "build:css": "node scripts/build-css.mjs",
    "build:docs": "node scripts/build-docs.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "watch": "node scripts/build-js.mjs --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krasenslavov/formajs.git"
  },
  "keywords": [
    "form",
    "forms",
    "form-validation",
    "validation",
    "ux",
    "dynamic",
    "interactive",
    "front-end",
    "vanilla-js",
    "no-dependencies"
  ],
  "author": "Krasen Slavov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/krasenslavov/formajs/issues"
  },
  "homepage": "https://formajs.krasenslavov.com",
  "devDependencies": {
    "esbuild": "^0.28.0",
    "jsdom": "^26.0.0",
    "sass": "^1.80.0",
    "vitest": "^5.0.5"
  }
}
